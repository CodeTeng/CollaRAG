# ---------- Project 运行产物 ----------
# 忽略根目录下的 data/（真实数据集体积大，不入库）
# 注意：必须用 /data/* 而非 /data/，git 不会进入被忽略的目录，否定规则才生效
/data/*
!/data/README.md
# mock_wiki 是项目自带的 100 条合成 QA（端到端 demo 依赖），必须入库
!/data/mock_wiki/
# docs/ 为本地设计与实验文档（含创新点规划），不随代码发布
/docs/
# 旧 README 含两个创新点的整体规划（创新点一未实装），发布版仅用根 README.md
/README_chimera.md
# output/
logs/
runs/
*.faiss
*.pkl
*.gpickle
storage/

# Model weights downloaded by scripts/download_embedding_model.py (~90MB each)
/models/

# ---------- Frontend (web-ui) ----------
web-ui/node_modules/
web-ui/dist/
web-ui/.vite/
web-ui/*.local
web-ui/npm-debug.log*
web-ui/yarn-debug.log*
web-ui/yarn-error.log*
web-ui/pnpm-debug.log*

# Frontend build output mounted by FastAPI — rebuilt from web-ui/ on demand
src/chimera_rag/web/static/

# ---------- CodeBuddy ----------
# 保留 .codebuddy 目录（它存储项目相关数据，不是临时缓存）
# 但忽略 plan 草稿，避免污染提交历史
.codebuddy/plans/

