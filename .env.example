# Copy this file to .env and fill in your credentials.
# Values in .env are loaded automatically by ChimeraRAG.from_config;
# existing shell environment variables take precedence over .env.

# ---- LLM (DeepSeek / OpenAI / any OpenAI-protocol endpoint) ----
# These three are the ONLY fields needed for the LLM. config.yaml only
# declares business knobs (temperature, max_tokens, retry, plugin toggles).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- (legacy, optional) Per-provider vars kept for backward compat ----
# If you prefer the old naming, these still work when LLM_* are unset.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ---- 本地 ollama（OpenAI 兼容接口）----
# ollama 不校验 api_key，填任意占位字符串即可（但不能为空）。
#LLM_API_KEY=ollama
#LLM_BASE_URL=http://localhost:11434/v1
# 改成你 `ollama pull` 下来的模型名，例如 qwen2.5 / llama3.1 / qwen2.5:7b。
#LLM_MODEL=qwen3:8b