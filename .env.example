# Chimera-RAG 环境变量示例
# 复制此文件为 .env，填入真实值
#
# LLM_PROVIDER 可选值：openai / deepseek / ollama / mock
LLM_PROVIDER=mock

# OpenAI 原生
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 复用 OpenAI SDK，覆盖 BASE_URL 与 MODEL
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama 本地
OLLAMA_HOST=http://localhost:11434

# EMBEDDING_PROVIDER 可选值：openai / ollama / sentence_transformer / mock
EMBEDDING_PROVIDER=mock
