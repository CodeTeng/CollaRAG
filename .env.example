# Copy this file to .env and fill in your API key.
# Values in .env are loaded automatically by ChimeraRAG.from_config;
# existing shell environment variables take precedence over .env.

# ---- API Key (required) ----
# The env var name is configured per slot via `api_key_env` in config.yaml
# (default LLM_API_KEY). All slots (LLM, embedding, rerank) can share the same
# key, or each can point at a different env var.
LLM_API_KEY=

# ---- [可选] 不同 slot 使用不同 key 时 ----
# EMBEDDING_API_KEY=
# RERANK_API_KEY=